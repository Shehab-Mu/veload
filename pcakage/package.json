{
  "name": "veload",
  "version": "0.1.0",
  "description": "A lightweight and customizable loading toolkit for Vue 3.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "homepage": "https://veload-playground.vercel.app",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "vue",
    "vue3",
    "loading",
    "spinner",
    "loader"
  ],
  "scripts": {
    "build": "vite build && npm run build:types",
    "typecheck": "vue-tsc --noEmit",
    "build:types": "vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir dist",
    "test": "vitest run",
    "check:consumer": "node scripts/consumer-check.mjs",
    "check:bundle": "node scripts/measure-bundle.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.2",
    "vue-tsc": "^3.3.13"
  }
}
