# Public origin of the deployment.
#
# Used for canonical links, Open Graph and Twitter URLs, the sitemap and the
# robots file. Set it to the real public origin of the site, for example:
#
#   NUXT_PUBLIC_SITE_URL=https://your-domain.example
#
# Leave it unset for local development and tests: the site then falls back to
# the origin of the incoming request, which is correct for localhost but can
# leak an internal proxy hostname in production.
NUXT_PUBLIC_SITE_URL=
